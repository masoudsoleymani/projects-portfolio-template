---
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
import ExperienceGridCard from '../components/ExperienceGridCard.astro';
import { site } from '@data/site';
import { Icon } from 'astro-icon/components';

const title = `Proyectos | ${site.hero.name}`;
const description = `Proyectos de ${site.hero.name}.`;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const homeHref = base;
---

<ArchiveLayout title={title} description={description}>
  <p class="mb-8">
    <a href={homeHref} class="group flex items-center gap-2 text-sm text-accent transition hover:text-slate-light" data-astro-prefetch>
      <Icon name="ph:arrow-left" class="h-4 w-4 transition-transform group-hover:-translate-x-1" />
      {site.hero.name}
    </a>
  </p>

  <h1 class="mb-4 text-4xl font-bold tracking-tight text-white sm:text-4xl">Projects</h1>

  <p class="mb-8 max-w-prose body-copy">
    Click on the project to view its GitHub repository.
  </p>

  <div class="grid gap-8 sm:grid-cols-2">
    {site.experiences.map((item) => <ExperienceGridCard item={item} />)}
  </div>
</ArchiveLayout>