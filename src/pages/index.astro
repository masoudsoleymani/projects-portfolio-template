---
import Layout from '../layouts/Layout.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Modelado from '../components/Modelado.astro';
import Normalizacion from '../components/Normalizacion.astro';
import Sql from '../components/Sql.astro';
import Proyecto from '../components/Proyecto.astro';
import Footer from '../components/Footer.astro';
import { site } from '../../data/site';

---

<Layout title={site.meta.title} description={site.meta.description}>
  <div id="about" data-tab-panel>
    <About />
    <Experience />
  </div>

  <div id="modelado" data-tab-panel hidden>
    <Modelado />
  </div>

  <div id="normalizacion" data-tab-panel hidden>
    <Normalizacion />
  </div>

  <div id="sql" data-tab-panel hidden>
    <Sql />
  </div>

  <div id="proyecto" data-tab-panel hidden>
    <Proyecto />
  </div>

  <Footer />
</Layout>

<style is:global>
  @media (min-width: 1024px) {
    .sidebar-shell {
      transform: translateX(-5rem);
      align-items: center;
      padding-right: 1.5rem;
      padding-left: 0;
      text-align: center;
    }

    .sidebar-content {
      width: 100%;
      max-width: 32rem;
      margin-left: 0;
      text-align: center;
    }

    .sidebar-content > div.flex.flex-col.items-center,
    .sidebar-content > .presentation-link,
    .sidebar-nav {
      align-items: center;
      text-align: center;
    }

    .sidebar-content > .presentation-link {
      margin-left: 0;
    }

    .sidebar-nav {
      width: min(100%, 22rem);
      margin-inline: auto;
    }

    .sidebar-nav .nav-caption {
      justify-content: center;
    }

    .sidebar-nav ul {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-items: unset;
      gap: 0.25rem;
      width: 100%;
    }

    .sidebar-nav li,
    .sidebar-nav .nav-link {
      width: auto;
    }

    .sidebar-nav .nav-link {
      display: inline-flex;
      justify-content: center;
      gap: 0.7rem;
      padding: 0.6rem 0.7rem;
      white-space: nowrap;
    }
  }
</style>
