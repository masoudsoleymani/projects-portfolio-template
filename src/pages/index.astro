---
import Layout from '../layouts/Layout.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Modelado from '../components/Modelado.astro';
import Normalizacion from '../components/Normalizacion.astro';
import Sql from '../components/Sql.astro';
import Proyecto from '../components/Proyecto.astro';
import Footer from '../components/Footer.astro';
import { site } from '../../data/site';

---

<Layout title={site.meta.title} description={site.meta.description}>
  <div id="about" data-tab-panel>
    <About />
    <Experience />
  </div>

  <div id="modelado" data-tab-panel hidden>
    <Modelado />
  </div>

  <div id="normalizacion" data-tab-panel hidden>
    <Normalizacion />
  </div>

  <div id="sql" data-tab-panel hidden>
    <Sql />
  </div>

  <div id="proyecto" data-tab-panel hidden>
    <Proyecto />
  </div>

  <Footer />
</Layout>

<style is:global>
  @media (min-width: 1024px) {
    .sidebar-shell {
      transform: translateX(-1.5rem);
      align-items: flex-start;
      padding-right: 1rem;
      padding-left: 1rem;
      text-align: left;
    }

    .sidebar-content,
    .sidebar-nav {
      width: 100%;
    }

    .sidebar-nav .nav-caption {
      justify-content: flex-start;
    }

    .sidebar-nav ul {
      display: flex;
      flex-flow: row wrap;
      justify-content: flex-start;
      gap: 0.35rem;
    }

    .sidebar-nav li {
      flex: 0 1 auto;
    }

    .sidebar-nav .nav-link {
      gap: 0.35rem;
      padding: 0.5rem 0.45rem;
      white-space: nowrap;
    }
  }
</style>
