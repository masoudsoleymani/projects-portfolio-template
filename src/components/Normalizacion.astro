---
import { site } from '@data/site';

const section = site.evidences.normalizacion;
const links = [
  { title: 'Relacional de Empareja2 en 3FN', url: '/MODELO%20RELACIONAL.png', description: 'Abre la imagen del modelo relacional de Empareja2 en tercera forma normal (3FN).' },
  { title: 'Taller de normalización (CSV)', url: '/TallerNormalizacion.csv', description: 'Descarga el archivo CSV del taller de normalización.' },
  { title: 'Taller de normalización (PDF)', url: '/TallerNormalizacion.pdf', description: 'Descarga el archivo PDF del taller de normalización.' },
];
---

<section id="normalizacion-content" class="mb-24 scroll-mt-24 lg:mb-32 lg:scroll-mt-8" aria-labelledby="normalizacion-heading">
  <div class="section-intro">
    <div>
      <span class="section-eyebrow"><span class="eyebrow-dot"></span> Evidencias · estructura de datos</span>
      <h2 id="normalizacion-heading" class="section-heading">{section.title}</h2>
    </div>
    <span class="document-count">03 <span>RECURSOS</span></span>
  </div>
  <div class="reveal-content mt-8 space-y-6">
    <div class="body-copy">{section.paragraphs.map((p) => <p>{p}</p>)}</div>
    <div class="link-stack">
      {links.map((link, index) => (
        <article class="link-item evidence-item" style={`--item-index:${index}`}>
          {link.url.endsWith('.png') && <a class="evidence-image" href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`Abrir ${link.title}`}><img src={link.url} alt={link.title} loading="lazy" /></a>}
          <span class="evidence-label">{link.url.endsWith('.pdf') ? 'PDF' : link.url.endsWith('.csv') ? 'DATOS' : 'DIAGRAMA'} <span>/{String(index + 1).padStart(2, '0')}</span></span>
          <h3 class="link-title">{link.title}</h3>
          <p class="link-description">{link.description}</p>
          <a href={link.url} target="_blank" rel="noopener noreferrer">{link.url.endsWith('.pdf') || link.url.endsWith('.csv') ? 'Abrir evidencia' : 'Ver diagrama'} <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .evidence-item { animation: evidence-rise 550ms both; animation-delay: calc(var(--item-index, 0) * 70ms); }
  .evidence-label { color: var(--color-accent); font: 0.62rem var(--font-mono); letter-spacing: .14em; }
  .evidence-label span { color: var(--color-subtext); }
  .evidence-image { display:block; width:100%; overflow:hidden; border:1px solid color-mix(in srgb,var(--color-subtext),transparent 82%); border-radius:.75rem; background:var(--color-background); }
  .evidence-image img { display:block; width:100%; max-height:14rem; object-fit:cover; transition:transform 450ms ease; }
  .evidence-image:hover img { transform:scale(1.035); }
  @keyframes evidence-rise { from {opacity:0; transform:translateY(12px)} to {opacity:1; transform:translateY(0)} }
  @media (prefers-reduced-motion: reduce) { .evidence-item { animation:none; } .evidence-image img { transition:none; } }
</style>
