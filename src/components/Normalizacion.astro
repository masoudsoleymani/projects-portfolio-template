---
import { site } from '@data/site';

const section = site.evidences.normalizacion;
const links = [
  {
    title: 'Taller de normalización (CSV)',
    url: '/TallerNormalizacion.csv',
    description: 'Descarga el archivo CSV del taller de normalización.',
  },
  {
    title: 'Taller de normalización (PDF)',
    url: '/TallerNormalizacion.pdf',
    description: 'Descarga el archivo PDF del taller de normalización.',
  },
];
---

<section
  id="normalizacion-content"
  class="mb-24 scroll-mt-24 lg:mb-32 lg:scroll-mt-8"
  aria-labelledby="normalizacion-heading"
>
  <h2 id="normalizacion-heading" class="section-heading">{section.title}</h2>

  <div class="reveal-content mt-8 space-y-6">
    <div class="body-copy">
      {section.paragraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>

    <figure class="normalizacion-diagrama">
      <img
        src="/RelacionalEmpareja2.svg"
        alt="Relacional de Empareja2 normalizado en tercera forma normal (3FN)"
        loading="lazy"
      />
      <figcaption>
        Relacional de Empareja2 normalizado en tercera forma normal (3FN).
      </figcaption>
    </figure>

    <div class="link-stack">
      {links.map((link) => (
        <div class="link-item">
          <h3 class="link-title">{link.title}</h3>
          <p class="link-description">{link.description}</p>
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block text-blue-600 underline hover:text-blue-800"
          >
            {link.title}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  .normalizacion-diagrama {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    border: 1px solid rgba(148, 163, 184, 0.25);
    background: rgba(15, 23, 42, 0.35);
    border-radius: 0.75rem;
  }

  .normalizacion-diagrama img {
    display: block;
    width: 100%;
    min-width: 700px;
    height: auto;
    border-radius: 0.5rem;
    background: #fff;
  }

  .normalizacion-diagrama figcaption {
    margin-top: 0.75rem;
    color: #cbd5e1;
    font-weight: 700;
  }

  .link-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .link-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border: 1px solid rgba(148, 163, 184, 0.25);
    background: rgba(15, 23, 42, 0.35);
    border-radius: 0.75rem;
    padding: 1rem 1.1rem;
  }

  .link-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: #f8fafc;
  }

  .link-description {
    margin: 0;
    color: #cbd5e1;
    line-height: 1.6;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
