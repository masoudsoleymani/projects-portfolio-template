---
import { site } from '../../data/site';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<section id="experiences" class="mb-24 scroll-mt-24 lg:mb-32 lg:scroll-mt-8" aria-labelledby="experience-heading">
  <h2 id="experience-heading" class="section-heading">Experiences</h2>
  <div class="space-y-4">
    {
      site.experiences.map((item) => (
        <a
          href={item.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="scroll-stat panel-card group grid gap-4 no-underline md:grid-cols-[9rem_1fr] md:gap-6"
          aria-label={`Ver repositorio de ${item.title} en GitHub`}
        >
          <p class="pt-1 font-mono text-xs uppercase tracking-wider text-slate">{item.period}</p>
          <div class="space-y-3">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-base font-semibold text-slate uppercase">
                {item.title} · {item.organization}
              </h3>
              {item.type && (
                <span class="rounded-full border border-accent/40 px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-wider text-accent">
                  {item.type}
                </span>
              )}
            </div>

            {item.image && (
              <div class="w-full max-w-3xl overflow-hidden rounded-xl">
                <img
                  src={`${base}${item.image}`}
                  alt={`${item.title} preview`}
                  class="h-48 w-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}

            <p class="body-copy">{item.summary}</p>
            <ul class="list-disc space-y-1 pl-5 text-sm text-slate">
              {item.highlights.map((point) => <li>{point}</li>)}
            </ul>
            <ul class="flex flex-wrap gap-3 pt-1">
              {item.tech.map((tech) => <li class="font-mono text-xs text-accent">{tech}</li>)}
            </ul>
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .scroll-stat {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-stat.reveal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  function revealCards() {
    const cards = document.querySelectorAll('.scroll-stat');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const index = Array.from(cards).indexOf(entry.target);
          setTimeout(() => {
            entry.target.classList.add('reveal');
          }, (index % 3) * 150); 
          
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.15,
      rootMargin: '0px 0px -10px 0px'
    });

    cards.forEach(card => observer.observe(card));
  }

  revealCards();
  
  document.addEventListener('astro:after-swap', revealCards);
</script>