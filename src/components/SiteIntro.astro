---
import { site } from '@data/site';
import ContactBar from './ContactBar.astro';
import CursorEyes from './CursorEyes.astro';

interface Props { variant: 'sidebar' | 'mobile'; }
const { variant } = Astro.props;
const isSidebar = variant === 'sidebar';
---

{isSidebar ? (
  <>
    <div class="relative group mb-8 reveal-content flex justify-center" style="animation-delay: 100ms;">
      <div class="avatar-orbit" aria-hidden="true"><span></span><span></span></div>
      <div class="balloon-float relative z-10 h-24 w-24 overflow-hidden rounded-full border-2 border-accent shadow-[0_0_50px_color-mix(in_srgb,var(--color-accent)_33%,transparent)]">
        <img src={site.hero.avatarSrc} alt={site.hero.avatarAlt} class="h-full w-full scale-110 object-cover" loading="eager" decoding="async" width="96" height="96" />
      </div>
      <div class="avatar-halo balloon-float absolute -z-10 top-0 left-0 h-full w-full rounded-full"></div>
    </div>
    <div class="flex flex-col items-center text-center">
      <span class="intro-kicker"><i></i> PORTAFOLIO PERSONAL</span>
      <a href={import.meta.env.BASE_URL} class="intro-name text-5xl font-bold tracking-tight text-white transition">{site.hero.name}</a>
      <div class="mt-2"><CursorEyes /></div>
      <p class="mt-3 text-xl font-medium text-slate-light">{site.hero.role}</p>
      <p class="body-copy mt-5 max-w-xs">{site.hero.tagline}</p>
      <p class="body-copy mt-4 max-w-xs">{site.hero.contact}</p>
      <div class="mt-3 flex justify-center gap-4"><ContactBar /></div>
    </div>
  </>
) : (
  <div class="flex flex-col items-center text-center">
    <div class="relative mb-4">
      <div class="avatar-orbit" aria-hidden="true"><span></span><span></span></div>
      <div class="relative z-10 h-20 w-20 overflow-hidden rounded-full border-2 border-accent shadow-[0_0_40px_color-mix(in_srgb,var(--color-accent)_28%,transparent)]">
        <img src={site.hero.avatarSrc} alt={site.hero.avatarAlt} class="h-full w-full object-cover" loading="eager" decoding="async" width="80" height="80" />
      </div>
    </div>
    <span class="intro-kicker"><i></i> PORTAFOLIO PERSONAL</span>
    <h1 class="intro-name text-4xl font-bold tracking-tight text-white transition">{site.hero.name}</h1>
    <div class="mt-2"><CursorEyes /></div>
    <p class="mt-3 text-xl font-semibold tracking-tight text-slate-light">{site.hero.role}</p>
    <div class="mt-4 max-w-prose space-y-3 text-lg leading-relaxed text-slate"><p>{site.hero.tagline}</p><p>{site.hero.contact}</p></div>
    <div class="mt-2 mb-6 flex items-center justify-center gap-4"><ContactBar /></div>
  </div>
)}

<style is:global>
  .intro-kicker { display:inline-flex; align-items:center; gap:.45rem; margin-bottom:.55rem; color:var(--color-accent); font: .58rem var(--font-mono); letter-spacing:.16em; }
  .intro-kicker i { width:.4rem; height:.4rem; border-radius:50%; background:var(--color-accent); box-shadow:0 0 10px var(--color-accent); }
  .intro-name { font-family:var(--font-heading); text-wrap:balance; text-shadow:0 0 32px color-mix(in srgb,var(--color-accent),transparent 91%); }
  .avatar-orbit { position:absolute; z-index:0; inset:-.6rem; display:grid; place-items:center; pointer-events:none; }
  .avatar-orbit span { position:absolute; width:100%; height:100%; border:1px solid color-mix(in srgb,var(--color-accent),transparent 67%); border-radius:50%; animation:orbit-pulse 4s ease-in-out infinite; }
  .avatar-orbit span:nth-child(2) { width:125%; height:125%; opacity:.45; animation-delay:-2s; }
  .avatar-halo { background:color-mix(in srgb,var(--color-accent),transparent 92%); filter:blur(16px); }
  @keyframes orbit-pulse { 50% { transform:scale(1.06); opacity:.45; } }
  @media(prefers-reduced-motion:reduce) { .avatar-orbit span { animation:none; } }
</style>
